{
  "id": "./",
  "name": "PitchCoach · practica a cantar",
  "short_name": "PitchCoach",
  "description": "Karaoke que te escucha: canta, afina y suma estrellas. Crea tus canciones tocando el piano o cantando.",
  "lang": "es",
  "dir": "ltr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#170640",
  "theme_color": "#170640",
  "categories": ["music", "education", "games"],
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/favicon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    {
      "name": "Crear canción",
      "short_name": "Crear",
      "description": "Abre el editor para escribir o grabar una melodía",
      "url": "./?accion=crear",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "audio/midi": [".mid", ".midi", ".kar"],
        "text/plain": [".txt"],
        "application/json": [".json"]
      }
    }
  ],
  "launch_handler": { "client_mode": "focus-existing" }
}
